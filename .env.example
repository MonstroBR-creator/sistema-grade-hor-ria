# Copie para `.env` e ajuste antes de publicar.
# O servidor lê tudo via process.env, sem dependência extra. Em produção
# (Render) defina no painel do serviço; localmente use:
#     node --env-file=.env backend/server.js

# Porta HTTP (o Render define sozinho)
PORT=3000

# Defina como "production" para ativar as validações estritas de segurança
NODE_ENV=development

# ------------------------------------------------------------------
# BANCO DE DADOS
# Com DATABASE_URL definida, o sistema usa PostgreSQL.
# Sem ela, usa SQLite em arquivo — que é o modo de desenvolvimento.
# ------------------------------------------------------------------
# DATABASE_URL=postgres://usuario:senha@host:5432/grade_horaria

# Caminho alternativo do arquivo SQLite (só sem DATABASE_URL)
# DB_PATH=C:\caminho\para\grade_horaria.db

# TLS na conexão Postgres: detectado automaticamente (ligado fora de
# localhost). Force com "true" ou "false" apenas se precisar.
# PGSSL=true

# ------------------------------------------------------------------
# SESSÃO
# ------------------------------------------------------------------
# OBRIGATÓRIO em produção — sem isso o servidor se recusa a iniciar.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-de-no-minimo-32-caracteres

# Validade do token de sessão
JWT_EXPIRACAO=8h

# ------------------------------------------------------------------
# CONTA MESTRE — a única conta criada na instalação.
# Só tem efeito no PRIMEIRO start, quando a conta ainda não existe.
# ------------------------------------------------------------------
MESTRE_USUARIO=mestre
MESTRE_SENHA=rasm2026
MESTRE_NOME=Usuário Mestre — RASM Tecnologia
# MESTRE_CPF=00000000000

# ------------------------------------------------------------------
# CARGA INICIAL
# Com o banco vazio, o servidor importa backend/data/professores.xlsx
# sozinho no start. Nunca sobrescreve dados existentes.
# Defina "false" para desligar.
# ------------------------------------------------------------------
IMPORTAR_NO_STARTUP=true
